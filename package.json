  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "assemblyscript": "^0.28.20",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
