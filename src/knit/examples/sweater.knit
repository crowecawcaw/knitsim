pattern "Lazy Sunday Relaxed Sweater"
source https://www.allfreeknitting.com/Knitted-Sweaters/Lazy-Sunday-Relaxed-Sweater
# Free pattern by Jodi Lewanda for Red Heart. Translated to Knit DSL;
# see the source for the real instructions and yarn.
param size enum S M L 1X 2X 3X = S "Size"
param sts float 8..13 = 10 "Your gauge: sts / 4in"
param rows float 11..18 = 14 "Your gauge: rows / 4in"
param main color = #3b6b58 "Yarn"

gauge ${sts} sts x ${rows} rows = 4 in
yarn ${main}

piece back
  cast_on 50/54/58/62/70/74
  rows until 2.5/2.5/2.5/3/3/3in rib2x2       # ribbed hem
  rows until 18/18/18/18.5/18.5/18.5in rev_st  # purl side is the right side
  marker underarm
  rows until 9/9.5/9.5/10/10/10in from underarm rev_st
  row rev_st bind_off center 16/18/18/20/20/22
  expect 17/18/20/21/25/26 17/18/20/21/25/26
  row rev_st dec neck 1
  expect 16/17/19/20/24/25 16/17/19/20/24/25
  bind_off
end

piece front
  cast_on 50/54/58/62/70/74
  rows until 2.5/2.5/2.5/3/3/3in rib2x2
  rows until 18/18/18/18.5/18.5/18.5in rev_st
  marker underarm
  rows until 6.5/7/7/7.5/7.5/7.5in from underarm rev_st
  row rev_st bind_off center 12/14/14/16/16/18
  expect 19/20/22/23/27/28 19/20/22/23/27/28
  repeat 3 {
    row rev_st dec neck 1
    row rev_st
  }
  expect 16/17/19/20/24/25 16/17/19/20/24/25
  rows until match back rev_st
  bind_off
end

piece sleeve_r
  cast_on 26/26/28/28/28/30
  rows 5 rev_st                    # 4 rows on smaller needles + 1 WS row
  repeat 2 { row rev_st inc edges ; rows 3 rev_st }
  expect 30/30/32/32/32/34
  repeat 5/5/2/3/3/0 { row rev_st inc edges ; rows 3 rev_st }
  expect 40/40/36/38/38/34
  rows 5 rev_st
  row rev_st inc edges
  expect 42/42/38/40/40/36
  repeat 3/4/6/6/6/8 { rows 5 rev_st ; row rev_st inc edges }
  expect 48/50/50/52/52/52
  rows until 17/18/18/19/19/19in rev_st
  bind_off
end

piece sleeve_l like sleeve_r

piece neckband round
  pick_up 48/48/52/52/52/56 from front.neck + back.neck
  rows until 3/3/3/3/3.5/3.5in rib2x2
  bind_off
end

assemble
  place front at front
  place back at back
  place sleeve_r at right_arm
  place sleeve_l at left_arm
  # shoulders
  seam front.top.1 = ~back.top.2
  seam front.top.2 = ~back.top.1
  # sleeves into armholes (between the underarm markers)
  seam sleeve_r.top = back.right[underarm:end] + ~front.left[underarm:end]
  seam sleeve_l.top = front.right[underarm:end] + ~back.left[underarm:end]
  # side + sleeve seams
  seam front.left[start:underarm] = back.right[start:underarm]
  seam front.right[start:underarm] = back.left[start:underarm]
  seam sleeve_r.left = sleeve_r.right
  seam sleeve_l.left = sleeve_l.right
end
